# Copier ce fichier vers .env et renseigner des valeurs locales.
# Ne jamais commiter de secret réel.

# --- Général ---
NODE_ENV=development
PORT=3000

# --- Base de données ---
# Doit correspondre aux identifiants définis dans docker-compose.yml pour le développement local.
DATABASE_URL=postgresql://notre_nid:notre_nid_dev_password@localhost:5432/notre_nid?schema=public

# --- Authentification ---
# Générer des valeurs aléatoires longues pour les secrets JWT, par exemple : openssl rand -hex 32
JWT_ACCESS_SECRET=changeme_access_secret_dev_only
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=changeme_refresh_secret_dev_only
JWT_REFRESH_TTL=30d

# --- Réseau / CORS ---
CORS_ORIGINS=http://localhost:8081
API_PUBLIC_URL=http://localhost:3000
# Variable publique consommée par l'application mobile (Expo) — ne jamais y placer de secret.
MOBILE_PUBLIC_API_URL=http://localhost:3000/api/v1

# --- Stockage des images ---
# STORAGE_DRIVER=local (disque local, apps/api/storage/uploads/ — développement uniquement)
#                | s3 (AWS S3, Supabase Storage, MinIO ou Cloudflare R2 — production)
# En s3, STORAGE_BUCKET/STORAGE_ACCESS_KEY/STORAGE_SECRET_KEY sont requis (l'API refuse de
# démarrer si l'un manque). STORAGE_ENDPOINT doit rester vide pour AWS S3 réel, ou pointer
# vers l'endpoint S3 AUTHENTIFIÉ du service compatible (Supabase Storage, MinIO local via
# --profile storage, ou l'endpoint https://<account>.r2.cloudflarestorage.com pour R2) — cet
# endpoint sert uniquement aux opérations d'upload/suppression, jamais à construire une URL
# publique. STORAGE_REGION/ACCESS_KEY/SECRET_KEY ci-dessous permettent de tester le driver s3
# en local contre MinIO.
STORAGE_DRIVER=local
STORAGE_BUCKET=notre-nid-dev
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=changeme_local_access_key
STORAGE_SECRET_KEY=changeme_local_secret_key

# STORAGE_PUBLIC_URL (optionnelle) : base d'URL réellement publique utilisée par le mobile
# pour afficher une couverture (ex. domaine personnalisé ou URL *.r2.dev pour Cloudflare R2).
# Distincte de STORAGE_ENDPOINT, qui est l'endpoint authentifié — pour R2 en particulier, ce
# dernier (*.r2.cloudflarestorage.com) N'EST JAMAIS accessible publiquement, il faut donc
# impérativement renseigner STORAGE_PUBLIC_URL. Laissée vide : le comportement précédent est
# conservé (URL construite depuis STORAGE_ENDPOINT+STORAGE_BUCKET, ou depuis STORAGE_BUCKET
# seul contre AWS S3 réel) — adapté à MinIO/Supabase Storage/AWS S3, où l'endpoint est déjà
# public.
STORAGE_PUBLIC_URL=

# --- Emails (capturés localement par Mailpit en développement) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Notre Nid <no-reply@notre-nid.local>

# --- Observabilité ---
SENTRY_DSN=
LOG_LEVEL=debug

# --- Résolution de code-barres (Bloc 3A/3B) ---
# GOOGLE_BOOKS_API_KEY est optionnelle : Google Books répond sans clé, mais avec des quotas
# bien plus bas et partagés entre tous les appelants anonymes — recommandé dès qu'un usage
# réel dépasse quelques recherches ponctuelles. Aucune clé n'est requise pour Open Library
# (fournisseur de repli), MusicBrainz ou Cover Art Archive, qui n'en proposent pas.
GOOGLE_BOOKS_API_KEY=
# Timeout réseau (ms) pour Google Books (fournisseur principal `book`) — passé ce délai, le
# fournisseur suivant de la chaîne est tenté plutôt que de laisser la requête indéfiniment
# ouverte.
BARCODE_PROVIDER_TIMEOUT_MS=5000
# Budget réseau TOTAL (ms) pour Open Library (fournisseur de repli `book`) — couvre l'ENSEMBLE
# des tentatives (au plus 2) et le délai entre elles, pas un timeout par tentative : deux
# tentatives de ce délai chacune rendrait une recherche mobile beaucoup trop longue. Réglé
# séparément de Google Books car ce fournisseur répond nettement plus lentement en production
# (voir docs/DECISIONS.md). Sur timeout, erreur réseau transitoire, ou réponse HTTP 502/503/504
# (passerelle/service indisponible), une seule nouvelle tentative est faite si le budget le
# permet encore (jamais sur un autre statut HTTP, résultat définitif du serveur).
OPEN_LIBRARY_TIMEOUT_BUDGET_MS=9000
# Budget réseau TOTAL (ms) pour MusicBrainz (fournisseur principal — et unique pour l'instant —
# `cd`), même principe que OPEN_LIBRARY_TIMEOUT_BUDGET_MS : couvre l'ENSEMBLE des tentatives (au
# plus 2), l'attente imposée par le limiteur de débit sortant comprise. Sur timeout, erreur
# réseau transitoire, ou réponse HTTP 429/503 (limite de débit dépassée côté MusicBrainz), une
# seule nouvelle tentative est faite si le budget le permet encore.
MUSICBRAINZ_TIMEOUT_BUDGET_MS=8000
# User-Agent envoyé à MusicBrainz — leur politique d'utilisation exige un identifiant
# d'application ET un moyen de contact (URL ou email), sous peine d'un débit réduit voire d'un
# blocage (voir docs/DECISIONS.md pour les sources consultées). Remplacer l'URL de contact si le
# dépôt change d'emplacement ou de mainteneur.
MUSICBRAINZ_USER_AGENT=NotreNid/0.1.0 (https://github.com/DeSousaDiego/NotreNid)
# Timeout réseau (ms) pour Cover Art Archive — enrichissement non bloquant d'un match MusicBrainz
# déjà trouvé (récupération de la couverture) : jamais de retry ici (une couverture manquante ou
# une panne de ce service ne doit jamais faire échouer une résolution CD par ailleurs valide, ni
# retarder indéfiniment la réponse). Contrairement à MusicBrainz, aucun rate limiter n'est
# appliqué : coverartarchive.org documente l'absence de limite de débit actuelle.
COVER_ART_ARCHIVE_TIMEOUT_MS=4000
# `dvd` — POC UPCitemdb + TMDB, pas encore exposé (voir docs/DECISIONS.md). Aucune clé requise
# pour UPCitemdb (plan FREE/trial, 100 requêtes combinées/jour, 6 lookups/minute). Budget réseau
# TOTAL (ms, tentatives + attente du rate limiter comprises), même principe que
# MUSICBRAINZ_TIMEOUT_BUDGET_MS.
UPCITEMDB_TIMEOUT_BUDGET_MS=8000
# User-Agent envoyé à UPCitemdb — bonne pratique, non documentée comme obligatoire pour ce
# fournisseur (contrairement à MusicBrainz).
UPCITEMDB_USER_AGENT=NotreNid/0.1.0 (https://github.com/DeSousaDiego/NotreNid)
# TMDB (The Movie Database) — enrichissement filmographique d'un DVD/Blu-ray déjà identifié
# physiquement par UPCitemdb, jamais exposé au mobile. Générer un « API Read Access Token » sur
# https://www.themoviedb.org/settings/api (compte gratuit) : c'est un long jeton (pas la « API
# Key » v3 classique), envoyé en Authorization: Bearer <token>. Ne JAMAIS commiter de vraie
# valeur ici ni l'envoyer côté mobile.
TMDB_READ_ACCESS_TOKEN=
# Budget réseau TOTAL (ms) pour TMDB, même principe que MUSICBRAINZ_TIMEOUT_BUDGET_MS. Contrairement
# à UPCitemdb, TMDB documente une limite bien plus généreuse (~40 requêtes/seconde, pas de quota
# journalier) — un retry sur 429/5xx y est donc acceptable, voir docs/DECISIONS.md.
TMDB_TIMEOUT_BUDGET_MS=8000
