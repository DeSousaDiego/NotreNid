# Copier ce fichier vers .env et renseigner des valeurs locales.
# Ne jamais commiter de secret réel.

# --- Général ---
NODE_ENV=development
PORT=3000

# --- Base de données ---
# Doit correspondre aux identifiants définis dans docker-compose.yml pour le développement local.
DATABASE_URL=postgresql://notre_nid:notre_nid_dev_password@localhost:5432/notre_nid?schema=public

# --- Authentification ---
# Générer des valeurs aléatoires longues pour les secrets JWT, par exemple : openssl rand -hex 32
JWT_ACCESS_SECRET=changeme_access_secret_dev_only
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=changeme_refresh_secret_dev_only
JWT_REFRESH_TTL=30d

# --- Réseau / CORS ---
CORS_ORIGINS=http://localhost:8081
API_PUBLIC_URL=http://localhost:3000
# Variable publique consommée par l'application mobile (Expo) — ne jamais y placer de secret.
MOBILE_PUBLIC_API_URL=http://localhost:3000/api/v1

# --- Stockage des images ---
# STORAGE_DRIVER=local (disque local, apps/api/storage/uploads/ — développement uniquement)
#                | s3 (AWS S3, Supabase Storage ou tout stockage compatible S3 — production)
# En s3, STORAGE_ENDPOINT doit rester vide pour AWS S3 réel, ou pointer vers l'endpoint du
# service compatible (Supabase Storage, MinIO local via --profile storage). Le bucket doit
# être configuré en lecture publique (voir docs/DEPLOYMENT.md). STORAGE_REGION/ACCESS_KEY/
# SECRET_KEY ci-dessous permettent de tester le driver s3 en local contre MinIO.
STORAGE_DRIVER=local
STORAGE_BUCKET=notre-nid-dev
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=changeme_local_access_key
STORAGE_SECRET_KEY=changeme_local_secret_key

# --- Emails (capturés localement par Mailpit en développement) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Notre Nid <no-reply@notre-nid.local>

# --- Observabilité ---
SENTRY_DSN=
LOG_LEVEL=debug
